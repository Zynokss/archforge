# Local source package. Run ../scripts/dist.sh from this directory first.
pkgname=archforge
pkgver=0.5.1
pkgrel=1
pkgdesc='Native Arch Linux system and gaming utility'
url='https://github.com/Zynokss/archforge'
arch=('x86_64' 'aarch64')
license=('MIT')
provides=("arch-forge=$pkgver")
conflicts=('arch-forge')
replaces=('arch-forge')
options=('!debug')
depends=('gtk4>=4.20' 'pacman' 'polkit' 'systemd' 'pciutils' 'curl')
makedepends=('rust' 'pkgconf')
optdepends=(
  'pacman-contrib: package cache maintenance and update checks'
  'vulkan-tools: Vulkan diagnostics'
  'gamemode: gaming performance requests and self-test'
  'mangohud: in-game hardware overlay'
  'ttf-material-symbols-variable: rounded Material icons'
)
source=("$pkgname-$pkgver.tar.gz")
# This PKGBUILD consumes a locally generated development archive.
sha256sums=('SKIP')

prepare() {
  cd "$pkgname-$pkgver"
  cargo fetch --locked
}

build() {
  cd "$pkgname-$pkgver"
  cargo build --release --frozen
}


package() {
  cd "$pkgname-$pkgver"
  install -Dm755 target/release/archforge "$pkgdir/usr/bin/archforge"
  install -Dm644 data/io.github.zynokss.ArchForge.desktop "$pkgdir/usr/share/applications/io.github.zynokss.ArchForge.desktop"
  install -Dm644 data/io.github.zynokss.ArchForge.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/io.github.zynokss.ArchForge.svg"
  install -Dm644 data/io.github.zynokss.ArchForge.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/archforge.svg"
  install -Dm644 data/icons/256.png "$pkgdir/usr/share/pixmaps/archforge.png"
  for size in 16 24 32 48 64 128 256 512; do
    install -Dm644 "data/icons/$size.png" "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/archforge.png"
    install -Dm644 "data/icons/$size.png" "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/io.github.zynokss.ArchForge.png"
  done
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
