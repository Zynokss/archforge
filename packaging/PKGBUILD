# Local source package. Run ../scripts/dist.sh from this directory first.
pkgname=archforge
pkgver=0.12.0
pkgrel=1
pkgdesc='Native Arch Linux system and gaming utility'
url='https://github.com/Zynokss/archforge'
arch=('x86_64' 'aarch64')
license=('MIT' 'GPL-3.0-only' 'CC0-1.0')
provides=("arch-forge=$pkgver" "archforge-cli=$pkgver")
conflicts=('arch-forge' 'archforge-cli')
replaces=('arch-forge')
options=('!debug')
depends=('vte4>=0.76' 'sudo' 'gtk4>=4.20' 'pacman' 'polkit' 'systemd' 'util-linux' 'pciutils' 'curl')
makedepends=('rust' 'pkgconf')
optdepends=(
  'docker: inspect container disk usage and prune dangling images'
  'virtualbox: inventory virtual machines and virtual disks'
  'timeshift: review and create configured system snapshots'
  'flatpak: install desktop apps on a separate app drive'
  'power-profiles-daemon: inspect available power profiles'
  'iproute2: inspect network interface addresses'
  'pacman-contrib: package cache maintenance and update checks'
  'vulkan-tools: Vulkan diagnostics'
  'gamemode: gaming performance requests and self-test'
  'mangohud: in-game hardware overlay'
  'ttf-material-symbols-variable: rounded Material icons'
)
source=("$pkgname-$pkgver.tar.gz")
# This PKGBUILD consumes a locally generated development archive.
sha256sums=('SKIP')

prepare() {
  cd "$pkgname-$pkgver"
  cargo fetch --locked
}

build() {
  cd "$pkgname-$pkgver"
  cargo build --release --frozen
}


package() {
  cd "$pkgname-$pkgver"
  install -Dm755 target/release/archforge-cli "$pkgdir/usr/bin/archforge-cli"
  install -Dm755 target/release/archforge "$pkgdir/usr/bin/archforge"
  install -Dm644 data/io.github.zynokss.ArchForge.desktop "$pkgdir/usr/share/applications/io.github.zynokss.ArchForge.desktop"
  install -Dm644 data/io.github.zynokss.ArchForge.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/io.github.zynokss.ArchForge.svg"
  install -Dm644 data/io.github.zynokss.ArchForge.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/archforge.svg"
  install -Dm644 data/icons/256.png "$pkgdir/usr/share/pixmaps/archforge.png"
  for size in 16 24 32 48 64 128 256 512; do
    install -Dm644 "data/icons/$size.png" "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/archforge.png"
    install -Dm644 "data/icons/$size.png" "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/io.github.zynokss.ArchForge.png"
  done
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -dm755 "$pkgdir/usr/share/archforge/app-icons"
  cp -r data/app-icons/. "$pkgdir/usr/share/archforge/app-icons/"
  install -Dm644 data/app-icons/Papirus-GPL-3.0.txt "$pkgdir/usr/share/licenses/$pkgname/Papirus-GPL-3.0.txt"
  install -Dm644 data/app-icons/Simple-Icons-CC0.md "$pkgdir/usr/share/licenses/$pkgname/Simple-Icons-CC0.md"
  install -Dm644 data/app-icons/NOTICE.md "$pkgdir/usr/share/licenses/$pkgname/Artwork-NOTICE.md"
}
